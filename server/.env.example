# Copie este arquivo para ".env" e preencha com os dados do seu app
# em https://discord.com/developers/applications -> seu app -> OAuth2

DISCORD_CLIENT_ID=coloque_o_client_id_aqui
DISCORD_CLIENT_SECRET=coloque_o_client_secret_aqui
DISCORD_REDIRECT_URI=http://localhost:3006/api/auth/discord/callback

# Token de BOT (diferente do client secret acima!). Usado só pra buscar o
# nome/foto do criador na tela de Créditos, direto na API oficial da Discord.
# Como conseguir: Developer Portal -> seu app -> aba "Bot" -> "Reset Token".
# Se você ainda não tiver um bot no seu app, crie um nessa mesma aba primeiro.
DISCORD_BOT_TOKEN=MTU0NjIzNDgyMzA2NzMwNDEwNw.G7xekQ.wGl1AV8r8oH9-348myadrFU5bgZDsfUIFwofPM

# Origem permitida pra fazer requisições ao backend (o próprio site)
CLIENT_ORIGIN=http://localhost:3006

# Ambiente: "development" ou "production"
NODE_ENV=development

# Porta do servidor
PORT=3006

# Opcional: se não definir, o servidor gera uma automaticamente a cada start
# (mas aí todo mundo é deslogado quando o servidor reinicia)
JWT_SECRET=troque_isso_por_uma_string_bem_aleatoria_e_longa

# Aba "Apoie" - cobranças Pix via Z.PAY (https://zpaysolution.com/docs/#payments-create)
# NUNCA coloque essas chaves no front-end, em HTML ou em repositório público.
# client-secret real: revogue/gere de novo no painel da Z.PAY se ela já
# vazou em algum lugar (chat, print, commit, etc.) antes de colocar aqui.
ZPAY_CLIENT_ID=zpk_3948da2e6b35a3d9d62ddf72
ZPAY_CLIENT_SECRET=zsk_1a16b775cb6727889023840f1710797fe8110a88295b7305 
# Tag usada em toda doação criada pelo site, pra separar do resto da conta Z.PAY
ZPAY_TAG=ZukScreen
