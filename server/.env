# Copie este arquivo para ".env" e preencha com os dados do seu app
# em https://discord.com/developers/applications -> seu app -> OAuth2

DISCORD_CLIENT_ID=1546234823067304107
DISCORD_CLIENT_SECRET=K-5i9s8Oc1d0Dl3qznNJc8zOCm_tWUjo
DISCORD_REDIRECT_URI=https://zuk-screen-e3te.vercel.app//api/auth/discord/callback

# Token de BOT (diferente do client secret acima!). Usado pra buscar o
# nome/foto do criador na tela de Créditos, direto na API oficial da Discord.
# Como conseguir: Developer Portal -> seu app -> aba "Bot" -> "Reset Token".
DISCORD_BOT_TOKEN=MTU0NjIzNDgyMzA2NzMwNDEwNw.G7xekQ.wGl1AV8r8oH9-348myadrFU5bgZDsfUIFwofPM

# Origem permitida pra fazer requisições ao backend (o próprio site)
CLIENT_ORIGIN=https://zuk-screen-e3te.vercel.app/

# Ambiente: "development" ou "production"
NODE_ENV=development

# Porta do servidor
PORT=3006

# Opcional: se não definir, o servidor gera uma automaticamente a cada start
# (mas aí todo mundo é deslogado quando o servidor reinicia)
JWT_SECRET=troque_isso_por_uma_string_bem_aleatoria_e_longa

# Aba "Apoie" - Z.PAY (https://zpaysolution.com/docs/#payments-create)
ZPAY_CLIENT_ID=zpk_3948da2e6b35a3d9d62ddf72
ZPAY_CLIENT_SECRET=zsk_1a16b775cb6727889023840f1710797fe8110a88295b7305
# Tag usada em toda doação criada pelo site - é o que garante que o ranking
# e o feed mostrem só doações do ZUK SCREEN, não de outra coisa que use a
# mesma conta Z.PAY. Precisa existir/ser criada no painel da Z.PAY.
ZPAY_TAG=zukscreen
